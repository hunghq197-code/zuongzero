{
  "name": "royalty-dashboard",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "preview_urls": false,
  "workers_dev": true,
  "assets": {
    "directory": "dist/client",
  },
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 2 15 * *"],
  },
  "vars": {
    "AUTH_PROVIDER": "app-session",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "royalty-dashboard-db",
      "database_id": "84e8a77b-13b1-440e-bbdb-f3b7ef69055b",
      "migrations_dir": "drizzle",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "royalty-dashboard-files",
    },
  ],
  "env": {
    "staging": {
      "name": "royalty-dashboard-staging",
      "workers_dev": true,
      "preview_urls": false,
      "triggers": {
        "crons": [],
      },
      "vars": {
        "AUTH_PROVIDER": "app-session",
        "APP_BASE_URL": "https://royalty-dashboard-staging.hung-hq197.workers.dev",
        "DEPLOYMENT_ENV": "staging",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "royalty-dashboard-staging-db",
          "database_id": "16451bff-d426-4ef1-a08e-d33c4d21dd27",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "royalty-dashboard-staging-files",
        },
      ],
    },
  },
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
}
