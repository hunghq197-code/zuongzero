{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "deploy:staging": "wrangler deploy --config wrangler.cloudflare.jsonc --env staging",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "db:generate": "drizzle-kit generate",
    "test": "npm run test:unit && npm run test:contracts",
    "test:unit": "node --test --experimental-strip-types tests/unit/settlements.test.mjs tests/unit/statement-payments.test.mjs tests/unit/reporting-periods.test.mjs tests/unit/app-auth.test.mjs tests/unit/login-otp.test.mjs tests/unit/guarantees.test.mjs tests/unit/statement-line-items.test.mjs tests/unit/royalty-rules.test.mjs tests/unit/statement-import-preview.test.mjs tests/unit/statement-export-files.test.mjs",
    "test:contracts": "node --test tests/static/security-contracts.test.mjs tests/static/staging-config.test.mjs",
    "test:production": "node tests/production-smoke.mjs",
    "test:staging": "node tests/production-smoke.mjs https://royalty-dashboard-staging.hung-hq197.workers.dev"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "8.5.2",
    "fflate": "^0.8.3",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
